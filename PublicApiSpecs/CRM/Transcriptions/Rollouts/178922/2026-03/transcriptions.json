        "tags" : [ "Basic" ],
        "summary" : "Retrieve transcript",
        "description" : "Retrieve a specific call transcript by its unique identifier. This endpoint allows you to access the details of a transcript, including its creation and update timestamps, engagement ID, source, and the transcript utterances. It is useful for reviewing and analyzing call interactions stored in your HubSpot account.",
